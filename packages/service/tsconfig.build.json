{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "build: JS and declarations for the published src, checked against web-standard globals only (no Node types), so the core stays portable; tests excluded",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2023", "WebWorker"],
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
