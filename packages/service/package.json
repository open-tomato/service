{
  "name": "@open-tomato/service",
  "version": "0.0.0",
  "description": "Framework-agnostic service core: dependency lifecycle, typed HTTP clients, retry and circuit breaking",
  "license": "Apache-2.0",
  "author": "Marcos Tomatti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/service.git",
    "directory": "packages/service"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-tomato/service-logger": "workspace:^"
  }
}
