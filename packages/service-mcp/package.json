{
  "name": "@open-tomato/service-mcp",
  "version": "0.0.0",
  "description": "Model Context Protocol adapter for @open-tomato/service: server factory, transports and health endpoints",
  "license": "Apache-2.0",
  "author": "Marcos Tomatti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/service.git",
    "directory": "packages/service-mcp"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
