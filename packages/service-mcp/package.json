  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@open-tomato/service": "workspace:^",
    "@open-tomato/service-logger": "workspace:^",
    "zod": "^4.6.7"
