{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "build: JS and declarations for the published src; tests excluded",
  "extends": ["./tsconfig.json", "@open-tomato/typescript-config/build"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
