{
  "name": "@open-tomato/service-logger",
  "version": "0.0.0",
  "description": "Pino logger with header redaction, with Node.js and browser entry points",
  "license": "Apache-2.0",
  "author": "Marcos Tomatti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/service.git",
    "directory": "packages/service-logger"
  },
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0"
  }
}
