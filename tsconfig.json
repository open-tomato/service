{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "root: scripts and config files, run by Bun; each package has its own",
  // tooling: the scripts never ship, and allowJs (for the root *.mjs files)
  // cannot run with isolatedDeclarations.
  "extends": ["@open-tomato/typescript-config/bun", "@open-tomato/typescript-config/tooling"],
  "compilerOptions": {
    "allowJs": true,
    "types": ["node", "bun"]
  },
  "include": ["scripts", "*.mjs", "*.ts"],
  "exclude": ["scripts/privacy-check.ts"]
}
