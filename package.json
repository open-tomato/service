{
  "name": "@open-tomato/service-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The service stack: a framework-agnostic core and its Express and MCP adapters",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "lint": "eslint .",
    "pack-check": "bun run scripts/pack.ts",
    "check-node": "node scripts/check-node.mjs",
    "gates": "bun run scripts/gates.ts"
  },
  "devDependencies": {
    "@open-tomato/eslint-config": "^0.1.0",
    "@open-tomato/typescript-config": "^0.1.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
