{
  "name": "@open-tomato/service-monorepo",
  "private": true,
  "description": "The service stack: a framework-agnostic core and its Express and MCP adapters",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "lint": "eslint .",
    "check-node": "node scripts/check-node.mjs",
    "gates": "bun run scripts/gates.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "globals": "^17.13.0",
    "jsonc-eslint-parser": "^3.3.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
